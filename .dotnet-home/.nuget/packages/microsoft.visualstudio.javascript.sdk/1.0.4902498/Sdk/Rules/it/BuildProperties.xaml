<Rule Name="BuildProperties" PageTemplate="generic" DisplayName="Creare" Description="Opzioni di compilazione" xmlns="http://schemas.microsoft.com/build/2009/properties">

    <Rule.DataSource>
        <DataSource Persistence="ProjectFile" HasConfigurationCondition="False"/>
    </Rule.DataSource>

    <StringProperty Name="BuildCommand" DisplayName="Comando di compilazione" Description="Comando da eseguire nella compilazione del progetto"/>

    <StringProperty Name="BuildOutputFolder" DisplayName="Cartella di output di compilazione" Description="Cartella in cui verranno inseriti gli oggetti della build di produzione."/>

    <StringProperty Name="CleanCommand" DisplayName="Comando Pulisci" Description="Comando da eseguire nella pulizia del progetto"/>

    <StringProperty Name="PackageJsonDirectory" DisplayName="Directory operativa" Description="Posizione package.json. Per impostazione predefinita, la radice del progetto." Default="$(MSBuildProjectDirectory)" Subtype="folder"/>

</Rule>
